{
  "name": "parentpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "reminders:run": "node --env-file=.env.development.local --import tsx scripts/send-fee-reminders.ts",
    "provision:institution": "node --env-file=.env.development.local --import tsx scripts/provision-institution.ts",
    "provision:owner": "node --env-file=.env.development.local --import tsx scripts/provision-platform-owner.ts",
    "db:push": "prisma db push",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^3.0.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
